# Automated Revenue System Configuration
# Copy this file to .env and add your actual API keys

# Trading APIs (Optional - for real trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET_KEY=your_coinbase_secret_key_here

# AI Content Generation (Optional - for enhanced content)
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Social Media APIs (Optional - for content distribution)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Affiliate Network APIs (Optional - for real tracking)
AMAZON_AFFILIATE_ID=your_amazon_affiliate_id_here
CLICKBANK_API_KEY=your_clickbank_api_key_here
COMMISSION_JUNCTION_API_KEY=your_cj_api_key_here

# Advertising APIs (Optional - for real ad management)
GOOGLE_ADS_API_KEY=your_google_ads_api_key_here
FACEBOOK_ADS_API_KEY=your_facebook_ads_api_key_here
LINKEDIN_ADS_API_KEY=your_linkedin_ads_api_key_here

# Email & Notifications (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Database Configuration (Optional - defaults to SQLite)
DATABASE_URL=sqlite:///revenue_system.db

# System Configuration
DEBUG_MODE=true
LOG_LEVEL=INFO
TIMEZONE=UTC

# Revenue Targets (Optional - for goal tracking)
DAILY_REVENUE_TARGET=500
MONTHLY_REVENUE_TARGET=15000
ANNUAL_REVENUE_TARGET=180000